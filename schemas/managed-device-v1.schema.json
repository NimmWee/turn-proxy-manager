{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FTM managed device v1 (no private key)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "device_id",
    "revision",
    "name",
    "platform",
    "wireguard",
    "freeturn",
    "management"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "format": {
      "const": "ftm-managed"
    },
    "device_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "platform": {
      "enum": [
        "android",
        "windows",
        "other"
      ]
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "client_public_key",
        "server_public_key",
        "preshared_key",
        "addresses",
        "allowed_ips",
        "dns",
        "mtu",
        "local_endpoint",
        "persistent_keepalive",
        "ipv6_policy"
      ],
      "properties": {
        "client_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "server_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "preshared_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "addresses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 49152
          }
        },
        "allowed_ips": {
          "const": [
            "0.0.0.0/0",
            "::/0"
          ]
        },
        "dns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "maxLength": 49152
          }
        },
        "mtu": {
          "type": "integer",
          "minimum": 576,
          "maximum": 1420
        },
        "local_endpoint": {
          "const": "127.0.0.1:9000"
        },
        "persistent_keepalive": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "ipv6_policy": {
          "const": "block"
        }
      }
    },
    "freeturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cid",
        "dns",
        "key",
        "mcap",
        "mode",
        "n",
        "obf",
        "peer",
        "provider",
        "spc",
        "transport",
        "v",
        "vk"
      ],
      "properties": {
        "cid": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "dns": {
          "type": "string",
          "maxLength": 49152
        },
        "key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mcap": {
          "type": "boolean"
        },
        "mode": {
          "const": "udp"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "obf": {
          "const": "rtpopus3"
        },
        "peer": {
          "type": "string",
          "maxLength": 49152,
          "minLength": 1
        },
        "provider": {
          "const": "vk"
        },
        "spc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "transport": {
          "const": "tcp"
        },
        "v": {
          "type": "integer",
          "const": 1
        },
        "vk": {
          "type": "string",
          "maxLength": 49152
        }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "api_path",
        "internal_api_ip",
        "tls_server_name",
        "refresh_seconds"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 49152
        },
        "api_path": {
          "const": "/api/client/v1/"
        },
        "internal_api_ip": {
          "type": "string",
          "format": "ipv4"
        },
        "tls_server_name": {
          "type": "string",
          "maxLength": 49152
        },
        "refresh_seconds": {
          "const": 1800
        }
      }
    }
  }
}
